# Copy to backend/.env. Use a dedicated DEVELOPMENT database/account.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vision_lab_dev
MYSQL_USER=vision_lab_dev
MYSQL_PASSWORD=
# Optional CA file for remote MySQL TLS verification:
MYSQL_SSL_CA=
# Never expose this single-process development service directly to the internet.
